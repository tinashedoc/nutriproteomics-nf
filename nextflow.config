manifest {
    name            = 'nutriproteomics-nf'
    description     = 'GWAS of nutrient pattern proteomic scores with fastGWA-MLM'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

params {
    // Input data
    input       = null        // table (tsv/whitespace or csv) of IDs, scores and covariates
    bfile       = null        // PLINK genotype prefix
    scores      = 'plant=plantdriven,animal=animaldriven,vitc=vitaminCsugar,retinol=retinolvitB12'
    fid_col     = 'FID'
    iid_col     = 'IID'
    qcovars     = 'age'       // quantitative covariates, comma separated ('none' for none)
    covars      = 'sex'       // categorical covariates, comma separated ('none' for none)
    n_pcs       = 10
    pc_prefix   = 'PC'        // PC columns are <pc_prefix>1 .. <pc_prefix><n_pcs>

    // Sparse GRM
    grm_snps      = null      // optional SNP list for the GRM; overrides pruning
    prune_grm     = true      // LD-prune common SNPs with PLINK for the GRM
    prune_window  = 50
    prune_step    = 5
    prune_r2      = 0.2
    grm_maf       = 0.01
    sparse_cutoff = 0.05

    // fastGWA
    gwas_covariates = true    // include covariates again at the GWAS stage
    gwas_maf        = 0.01
    gwas_geno       = 0.05

    // Summary
    p_threshold = 5e-8
    n_top_hits  = 100

    // Tools and output
    gcta   = 'gcta64'
    plink  = 'plink'
    outdir = 'results'
}

process {
    cpus   = 1
    memory = 4.GB
    time   = 4.h

    withLabel: 'process_low'    { cpus = 1;  memory = 4.GB;  time = 2.h  }
    withLabel: 'process_medium' { cpus = 4;  memory = 16.GB; time = 8.h  }
    withLabel: 'process_high'   { cpus = 20; memory = 64.GB; time = 48.h }

    withName: 'TRANSFORM_PHENOTYPES' { publishDir = [path: { "${params.outdir}/phenotypes" }, mode: 'copy'] }
    withName: 'PRUNE_SNPS'           { publishDir = [path: { "${params.outdir}/grm" }, mode: 'copy'] }
    withName: 'SPARSE_GRM'           { publishDir = [path: { "${params.outdir}/grm" }, mode: 'copy'] }
    withName: 'FASTGWA'              { publishDir = [path: { "${params.outdir}/gwas" }, mode: 'copy'] }
    withName: 'GWAS_SUMMARY'         { publishDir = [path: { "${params.outdir}/summary" }, mode: 'copy'] }
}

profiles {
    conda {
        conda.enabled  = true
        process.conda  = "${projectDir}/environment.yml"
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
        process.conda  = "${projectDir}/environment.yml"
    }
    micromamba {
        conda.enabled        = true
        conda.useMicromamba  = true
        process.conda        = "${projectDir}/environment.yml"
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        params.input     = "${projectDir}/tests/data/phenotypes.tsv"
        params.bfile     = "${projectDir}/tests/data/genotypes"
        params.n_pcs     = 3
        params.prune_r2  = 0.5
        params.outdir    = 'results_test'
        process {
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB }
            withLabel: 'process_high'   { cpus = 2; memory = 2.GB }
        }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
